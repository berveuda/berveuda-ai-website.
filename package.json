{
  "name": "berveuda-ai-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .build/server && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json",
    "lint": "eslint .",
    "db:local": "wrangler d1 execute berveuda-inquiries --local --config wrangler.local.jsonc --file migrations/0001_inquiries.sql",
    "start:local": "wrangler pages dev dist --d1 DB=00000000-0000-4000-8000-000000000001 --compatibility-date 2026-06-01 --ip 127.0.0.1 --port 8788",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261119.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "wrangler": "4.165.0"
  }
}
